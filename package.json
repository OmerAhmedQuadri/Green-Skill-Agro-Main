{
  "name": "green-agro",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "db:generate": "pnpm --filter @gsa/db generate",
    "db:migrate": "pnpm --filter @gsa/db migrate",
    "db:seed": "pnpm --filter @gsa/db seed"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
