{
  "name": "@gsa/services",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "sync": "tsx --env-file-if-exists=../../.env src/scripts/sync.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "first-admin": "tsx --env-file-if-exists=../../.env src/scripts/first-admin.ts",
    "import-workbook": "tsx --env-file-if-exists=../../.env src/scripts/import.ts",
    "test:r2": "vitest run --config vitest.r2.config.ts",
    "backup": "tsx --env-file-if-exists=../../.env src/scripts/backup.ts"
  },
  "dependencies": {
    "@gsa/config": "workspace:*",
    "@gsa/contracts": "workspace:*",
    "@gsa/core": "workspace:*",
    "@gsa/db": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "nodemailer": "10.0.10",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@gsa/eslint-config": "workspace:*",
    "@gsa/tsconfig": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "fast-check": "4.9.0",
    "pg": "8.23.0",
    "tsx": "4.23.13"
  }
}
