# ---------------------------------------------------------------------------
# Project documentation — deliberately NOT version controlled
#
# docs/ holds the Phase 1 scope, requirements, architecture and decision
# records, including the client's commercial scope document under
# docs/reference/. These stay local by explicit instruction.
#
# ---------------------------------------------------------------------------
docs/

# Client source documents
*.docx
*.doc
*.pdf

# ---------------------------------------------------------------------------
# Standard Node / Next.js monorepo ignores
# (added pre-emptively — the repo has no .gitignore and will shortly hold a
#  pnpm workspace. Trim anything unwanted.)
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Secrets — never commit
.env
.env.*
!.env.example

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# Test & coverage
coverage/
playwright-report/
test-results/

# Turborepo
.turbo/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS & editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Local scratch
tmp/
scratch/

# Agent instructions — a doc, and docs are never committed
CLAUDE.md
# Agent-instruction files Next.js 16 writes on `next dev` — docs, never committed
AGENTS.md

# Generated by Next.js
next-env.d.ts

# ---------------------------------------------------------------------------
# Documentation and Claude files are never committed (project rule).
# Covers docs/, CLAUDE.md and AGENTS.md above, plus any other markdown and
# Claude's local settings. README.md was committed before this rule and stays.
# ---------------------------------------------------------------------------
*.md
!/README.md
.claude/
