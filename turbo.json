{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
