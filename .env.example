# Copy to .env — every value is read by packages/config (DEVELOPMENT §4).

# --- Database: runtime role (append-only on ledgers) and owner role (migrations)
POSTGRES_PORT=5432
POSTGRES_OWNER_PASSWORD=gsa_owner_dev
POSTGRES_APP_PASSWORD=gsa_app_dev
DATABASE_URL=postgres://gsa_app:gsa_app_dev@localhost:5432/gsa
DATABASE_OWNER_URL=postgres://gsa_owner:gsa_owner_dev@localhost:5432/gsa

# --- App
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes-per-environment
LOG_LEVEL=info

# --- Object storage (ADR-0020)
#     Development app: Cloudflare R2 test bucket — set by hand, never shared in chat:
#       S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#       S3_REGION=auto   S3_BUCKET=gsa-media-test   + a token scoped to that bucket
#     Offline / automated tests: the SeaweedFS values below.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gsa-media
S3_ACCESS_KEY=gsa_s3
S3_SECRET_KEY=gsa_s3_dev_secret

# --- Email (Mailpit locally: http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Green Agro <no-reply@localhost>"

# --- Development seed only. Never set in production.
DEV_SEED_PASSWORD=
