# Copy to .env — every value is read by packages/config (DEVELOPMENT §4).

# --- Database: runtime role (append-only on ledgers) and owner role (migrations)
POSTGRES_PORT=5432
POSTGRES_OWNER_PASSWORD=gsa_owner_dev
POSTGRES_APP_PASSWORD=gsa_app_dev
DATABASE_URL=postgres://gsa_app:gsa_app_dev@localhost:5432/gsa
DATABASE_OWNER_URL=postgres://gsa_owner:gsa_owner_dev@localhost:5432/gsa

# --- App
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes-per-environment
LOG_LEVEL=info

# --- Object storage: Cloudflare R2 (ADR-0020). Set by hand — never paste keys into chat.
#     Development uses the test bucket; production gets its own buckets and tokens.
#     The app refuses to start until these are real values.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=gsa-media-test
S3_ACCESS_KEY=
S3_SECRET_KEY=
#     Optional prefix for every object key, e.g. ci/ — CI shares the test bucket under it.
S3_KEY_PREFIX=

# --- Database backups: their own bucket and their own bucket-scoped token (ADR-0020).
#     The media token above is given to browsers in signed upload URLs, so it must
#     never be able to reach the backups. Blank here: only the machine that takes
#     backups sets them. See docs/handover/RUNBOOK.md §5.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=30

# --- Email: nodemailer over SMTP (ADR-0022). Locally, Mailpit catches every email: http://localhost:8025
#     Interim real sender — a Gmail account with an app password, set by hand, never pasted in chat:
#       SMTP_URL=smtps://<account>%40gmail.com:<app-password-without-spaces>@smtp.gmail.com:465
#       MAIL_FROM="Green Skill Agro <<account>@gmail.com>"
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Green Skill Agro <no-reply@localhost>"

# --- Development seed only. Never set in production.
DEV_SEED_PASSWORD=
